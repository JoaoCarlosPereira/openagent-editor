{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "files": [
    "packages/workspace-scaffold.ts"
  ],
  "include": [
    "packages/**/*.ts",
    "services/**/*.ts",
    "apps/**/*.ts",
    "extension/**/*.js",
    "tests/**/*.js"
  ]
}
