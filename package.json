{
  "name": "openagent-editor",
  "displayName": "OpenAgent Editor",
  "publisher": "openagent",
  "description": "Open source AI assistance for Code OSS and VS Code compatible editors",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "buildNote": "build validates workspace dependencies, TypeScript, and lint; it does not package an editor application.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": { "vscode": "^1.96.0" },
  "main": "./extension/index.js",
  "activationEvents": [
    "onView:openagent.chat",
    "onCommand:openagent.ask",
    "onCommand:openagent.editSelection",
    "onCommand:openagent.agent",
    "onCommand:openagent.setApiKey"
  ],
  "contributes": {
    "commands": [
      { "command": "openagent.ask", "title": "OpenAgent: Ask about Selection" },
      { "command": "openagent.editSelection", "title": "OpenAgent: Edit Selection" },
      { "command": "openagent.agent", "title": "OpenAgent: Open Agent" },
      { "command": "openagent.setApiKey", "title": "OpenAgent: Set API Key" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "openagent", "title": "OpenAgent", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "openagent": [
        { "id": "openagent.chat", "name": "Chat", "type": "webview" }
      ]
    },
    "configuration": {
      "title": "OpenAgent",
      "properties": {
        "openagent.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Base URL of an OpenAI compatible chat completions API."
        },
        "openagent.model": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model identifier accepted by the configured API."
        },
        "openagent.maxContextCharacters": {
          "type": "integer",
          "default": 12000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Maximum characters sent from the selected editor context."
        },
        "openagent.inlineCompletion.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable inline code suggestions. Sends nearby code to the configured provider as you type."
        }
      }
    },
    "menus": {
      "editor/context": [
        { "command": "openagent.ask", "when": "editorHasSelection", "group": "navigation@10" },
        { "command": "openagent.editSelection", "when": "editorHasSelection", "group": "navigation@11" }
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check extension/index.js && node --check extension/client.js && node --check extension/html.js && node --check extension/context.js && node --check extension/inline.js && node --check extension/agent.js && node --check extension/paths.js",
    "build": "npm run build:workspace",
    "build:workspace": "npm ls --depth=0 && npm run typecheck && npm run lint",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
